# OS
.DS_Store
Thumbs.db

# Local scratch (never committed)
_scratch/

# Oracle spike output. Regenerated by tools/cobol-oracle/run-oracle.sh; never committed --
# the run over the shipped data produces all-zero amounts (PR #34), so it is not a usable fixture.
oracle-out/

# ---------------------------------------------------------------------------
# LangGraph Dev / LangGraph Studio - LOCAL ONLY, NEVER COMMITTED.
#
# One directory holds the whole local harness (langgraph.json, the Studio
# entrypoint module, .env, the launcher), so one rule covers it.
# .langgraph-dev/.gitignore repeats the exclusion from the inside as a backstop.
.langgraph-dev/

# The dev server's own local state: it pickles threads/runs/assistants into
# .langgraph_api/ beside its working directory. start.ps1 runs it from outside the
# repo so this should never appear here - ignored at any depth in case the server
# is ever launched from the repo root instead.
.langgraph_api/
**/.langgraph_api/

# A langgraph.json accidentally created at the repo root (e.g. by `langgraph new`,
# or by copying the config out of .langgraph-dev/). This repository ships no
# LangGraph Platform config; the only one that exists is the ignored local copy.
/langgraph.json
